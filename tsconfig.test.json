{
  // The unit tests in src/, which run in Node (Vitest), so they can use
  // Node's own modules. Everything else matches the app's settings.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.node-testing.ts",
    "src/globals.d.ts"
  ],
  "exclude": []
}
